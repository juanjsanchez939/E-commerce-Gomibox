# Copiá este archivo a backend/.env y completá los valores.
# backend/.env está en .gitignore: nunca se commitea.

PORT=5010
NODE_ENV=development

# Debe coincidir con las credenciales de tu .env de la raíz (el que usa docker-compose).
# Generá la password con: openssl rand -base64 24
MONGO_URI=mongodb://<usuario>:<password>@127.0.0.1:27018/gomibox?authSource=admin

# OBLIGATORIO: mínimo 32 caracteres. El backend no arranca sin esto.
# Generá uno con: openssl rand -base64 48
JWT_SECRET=

JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Solo lo usa el script de alta de admin (mínimo 12 caracteres).
ADMIN_EMAIL=admin@gomibox.com
ADMIN_PASSWORD=
